# Copy this file to ".env" in the project root and fill in your values.
# Groq API key (free tier works for testing): https://console.groq.com/keys
GROQ_API_KEY=
# Vision model used for extraction
GROQ_MODEL=qwen/qwen3.8-27b
# Max images (pages) per document sent to Groq in one request; qwen/qwen3.8-27b accepts 3
GROQ_MAX_IMAGES=3
PORT=3000
# Where the SQLite database and uploaded page images are stored
DATA_DIR=./data
# Fields whose model confidence is below this value are flagged as doubtful (0-1)
CONFIDENCE_THRESHOLD=0.75
