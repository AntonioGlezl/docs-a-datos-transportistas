{
  "name": "docs-a-datos",
  "version": "0.1.0",
  "private": true,
  "description": "Extract structured data from delivery documents (albarán, factura, CMR) with Groq vision and export to Excel",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "share": "node --env-file-if-exists=.env scripts/share.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "pdfjs-dist": "^6.5.438"
  }
}
